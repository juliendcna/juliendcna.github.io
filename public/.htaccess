# Apache config for the OVH host (ignored by GitHub Pages)

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # one canonical origin: HTTPS on the bare domain
  RewriteCond %{SERVER_PORT} ^80$ [OR]
  RewriteCond %{HTTP_HOST} ^www\.dacunha\.ovh$ [NC]
  RewriteRule ^ https://dacunha.ovh%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # hashed build assets never change; everything else revalidates
  <FilesMatch "\.(js|css|woff2|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.svg|favicon\.ico|apple-touch-icon\.png|robots\.txt|ads\.txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
