---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionShell from './SectionShell.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

const badges = import.meta.glob<{ default: ImageMetadata }>('../assets/badges/*.{png,svg}', { eager: true });
const monthYear = new Intl.DateTimeFormat(lang, { month: 'short', year: 'numeric' });
const certs = dict.certifications.items.map((cert) => ({
  ...cert,
  image: cert.badge ? badges[`../assets/badges/${cert.badge}`]?.default : undefined,
  badgeId: cert.url?.match(/credly\.com\/badges\/([0-9a-f-]{36})/)?.[1],
  verifiable: cert.url?.includes('credly.com/badges/') ?? false,
  issued: cert.issued ? `${dict.certifications.issued} ${monthYear.format(new Date(cert.issued))}` : cert.year,
}));
---

<SectionShell id="certifications" heading={dict.certifications.heading}>
  <ul class="certs">
    {
      certs.map((cert) => (
        <li class="cert" data-reveal>
          {cert.image && (
            <Image src={cert.image} alt="" width={128} height={128} densities={[1, 2]} loading="lazy" class="badge" />
          )}
          <h3 class="title">{cert.title}</h3>
          <p class="org mono">{cert.org}</p>
          <p class="dates mono">{cert.issued}</p>
          {cert.note && <p class="note muted">{cert.note}</p>}
          {cert.url && (
            <a class="view mono link" href={cert.url} target="_blank" rel="noopener">
              {cert.verifiable ? dict.certifications.verify : dict.certifications.view} ↗
            </a>
          )}
        </li>
      ))
    }
  </ul>

  {/* light theme: Credly's own white widgets, plus a matching tile for badges not on Credly */}
  <ul class="certs-light">
    {
      certs.map((cert) => (
        <li class="tile" data-reveal>
          <h3 class="sr-only">
            {cert.title} — {cert.org}, {cert.year}
          </h3>
          {cert.badgeId ? (
            <div class="frame">
              {/* embed.js replaces this inner div with the iframe; the wrapper keeps the box */}
              <div
                class="embed"
                data-iframe-width="150"
                data-iframe-height="270"
                data-share-badge-id={cert.badgeId}
                data-share-badge-host="https://www.credly.com"
              >
                <a class="fallback mono" href={cert.url} target="_blank" rel="noopener">
                  {cert.title} ↗
                </a>
              </div>
            </div>
          ) : (
            <a class="frame mimic" href={cert.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
              {cert.image && <Image src={cert.image} alt="" width={106} height={106} densities={[1, 2]} loading="lazy" class="mimic-img" />}
              <span class="mimic-title">{cert.title}</span>
              <span class="mimic-issuer">Issuer: {cert.org}</span>
              <span class="mimic-foot">&nbsp;</span>
            </a>
          )}
          <p class="tile-year mono" aria-hidden="true">{cert.year}</p>
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 1.25rem;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem 1rem 1.5rem;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: var(--night-raised);
    transition: border-color 250ms ease, transform 250ms ease, box-shadow 250ms ease;
  }

  .cert:hover {
    border-color: color-mix(in srgb, var(--glacial) 45%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 14px 34px -18px color-mix(in srgb, var(--glacial) 40%, transparent);
  }

  .badge {
    width: 128px;
    height: 128px;
    object-fit: contain;
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.25));
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cert:hover .badge {
    transform: scale(1.06) rotate(-3deg);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 0.45rem;
  }

  .org {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.9rem;
  }

  .dates {
    font-size: 0.75rem;
    color: var(--dim);
  }

  .note {
    font-size: 0.8125rem;
    line-height: 1.45;
    margin-top: 0.6rem;
  }

  .view {
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.75rem;
  }

  /* ---- light theme: Credly widgets ---- */
  .certs-light {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 1.5rem;
  }

  @media (prefers-color-scheme: light) {
    .certs {
      display: none;
    }

    .certs-light {
      display: flex;
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* the Credly iframe's exact box, reserved before it loads (no layout shift) */
  .frame {
    width: 150px;
    height: 270px;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 0 0 1px var(--hairline);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .tile:hover .frame {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--glacial) 50%, transparent),
      0 14px 34px -18px color-mix(in srgb, var(--glacial) 45%, transparent);
  }

  .frame :global(iframe) {
    display: block;
    border: 0;
  }

  .embed {
    height: 100%;
  }

  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    text-align: center;
    font-size: 0.75rem;
    color: #16181d;
    text-decoration: underline;
  }

  /* same layout and type as Credly's widget, for the CCNA2 badge */
  .mimic {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 22px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
    color: #2d2d2d;
  }

  .mimic-img {
    width: 106px;
    height: 106px;
    object-fit: contain;
    margin-bottom: 23px;
  }

  .mimic-title {
    width: 100%;
    padding-inline: 0.6rem;
    font-size: 15px;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mimic-issuer {
    width: 100%;
    padding-inline: 0.6rem;
    margin-top: 4px;
    font-size: 13px;
    font-style: italic;
    color: #6f6f6f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mimic-foot {
    width: 100%;
    margin-top: 14px;
    padding-block: 9px;
    background: #f2f2f2;
    border-top: 1px solid #e6e6e6;
    font-size: 9px;
    letter-spacing: 0.08em;
    color: #9a9a9a;
  }

  .tile-year {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--glacial);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .cert,
    .badge {
      transition: none;
    }

    .tile:hover .frame,
    .cert:hover,
    .cert:hover .badge {
      transform: none;
    }
  }
</style>

<script>
  /* Credly's third-party script is only needed for the light theme, and only
     once the section is close to the viewport. */
  const section = document.querySelector('#certifications');
  const light = window.matchMedia('(prefers-color-scheme: light)');

  if (section?.querySelector('[data-share-badge-id]')) {
    let near = false;
    let loaded = false;

    const maybeLoad = () => {
      if (loaded || !near || !light.matches) return;
      loaded = true;
      const script = document.createElement('script');
      script.src = 'https://cdn.credly.com/assets/utilities/embed.js';
      script.async = true;
      document.body.append(script);
    };

    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          near = true;
          maybeLoad();
        }
      },
      { rootMargin: '600px 0px' }
    ).observe(section);

    light.addEventListener('change', () => {
      /* the list that just became visible was display:none, so it never got
         its scroll-reveal class */
      section.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('in'));
      maybeLoad();
    });
  }
</script>
