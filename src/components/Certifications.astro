---
import SectionShell from './SectionShell.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

const certs = dict.certifications.items.map((cert) => ({
  ...cert,
  badgeId: cert.url?.match(/credly\.com\/badges\/([0-9a-f-]{36})/)?.[1],
}));
---

<SectionShell id="certifications" heading={dict.certifications.heading}>
  <ul class="certs">
    {
      certs.map((cert) => (
        <li class="cert" data-reveal>
          <h3 class="sr-only">
            {cert.title} — {cert.org}, {cert.year}
          </h3>
          {cert.badgeId ? (
            <div class="badge">
              {/* embed.js replaces this inner div with the iframe; the wrapper keeps the frame */}
              <div
                class="embed"
                data-iframe-width="150"
                data-iframe-height="270"
                data-share-badge-id={cert.badgeId}
                data-share-badge-host="https://www.credly.com"
              >
                <a class="fallback mono link" href={cert.url} target="_blank" rel="noopener">
                  {cert.title} ↗
                </a>
              </div>
            </div>
          ) : (
            <div class="badge plain">
              <p class="plain-title">{cert.title}</p>
              <p class="org mono muted">{cert.org}</p>
              {cert.note && <p class="note muted">{cert.note}</p>}
              {cert.url && (
                <a class="mono link" href={cert.url} target="_blank" rel="noopener">
                  {dict.certifications.view} ↗
                </a>
              )}
            </div>
          )}
          <p class="year mono" aria-hidden="true">{cert.year}</p>
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .certs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 1.5rem;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* exact box of the Credly iframe, reserved before it loads (no layout shift) */
  .badge {
    width: 150px;
    height: 270px;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 0 0 1px var(--hairline);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .cert:hover .badge {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--glacial) 50%, transparent),
      0 14px 34px -18px color-mix(in srgb, var(--glacial) 45%, transparent);
  }

  .badge :global(iframe) {
    display: block;
    border: 0;
  }

  /* shown until embed.js swaps in the iframe, and without JavaScript */
  .embed {
    height: 100%;
  }

  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    text-align: center;
    font-size: 0.75rem;
    color: #16181d;
  }

  .plain {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.1rem;
    text-align: center;
    background: var(--night-raised);
  }

  .plain-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.3;
  }

  .plain .org {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plain .note {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .plain .link {
    font-size: 0.75rem;
  }

  .year {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--glacial);
  }

  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }
  }
</style>

<script>
  /* Credly's embed script is third-party: only fetch it once the section is
     close to the viewport, so it never weighs on the initial page load. */
  const section = document.querySelector('#certifications');

  if (section?.querySelector('[data-share-badge-id]')) {
    const load = () => {
      const script = document.createElement('script');
      script.src = 'https://cdn.credly.com/assets/utilities/embed.js';
      script.async = true;
      document.body.append(script);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '600px 0px' }
      );
      io.observe(section);
    } else {
      load();
    }
  }
</script>
