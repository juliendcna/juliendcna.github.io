---
import SectionShell from './SectionShell.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

const channels = [
  {
    label: dict.contact.locationLabel,
    value: 'Geneva, Switzerland',
    href: 'https://www.google.com/maps/search/Geneva',
  },
  { label: dict.contact.emailLabel, value: 'julien@dacunha.ovh', href: 'mailto:julien@dacunha.ovh' },
  { label: dict.contact.githubLabel, value: 'github.com/juliendcna', href: 'https://github.com/juliendcna' },
  {
    label: dict.contact.linkedinLabel,
    value: 'Julien Da Cunha',
    href: 'https://www.linkedin.com/in/julien-da-cunha',
  },
];
---

<SectionShell id="contact" keyLabel={dict.contact.key} heading={dict.contact.heading}>
  <p class="pitch muted" data-reveal>{dict.contact.body}</p>
  <p class="big" data-reveal>
    <a href="mailto:julien@dacunha.ovh" aria-label={dict.contact.button}>julien@dacunha.ovh</a>
  </p>
  <ul class="channels">
    {
      channels.map((c) => (
        <li data-reveal>
          <p class="label mono muted">{c.label}</p>
          <a class="link" href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
            {c.value}
          </a>
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .pitch {
    font-size: 1.125rem;
    max-width: 34em;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .big a {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    font-size: clamp(1.7rem, 6vw, 4.5rem);
    line-height: 1.1;
    color: var(--bone);
    background-image: linear-gradient(var(--glacial), var(--glacial));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size 450ms cubic-bezier(0.22, 1, 0.36, 1), color 300ms ease;
  }

  .big a:hover {
    color: var(--glacial);
    background-size: 100% 2px;
  }

  .channels {
    display: grid;
    gap: 1.75rem 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 720px) {
    .channels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .label {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
</style>
