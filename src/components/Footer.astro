---
import TechIcon from './TechIcon.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap inner">
    <p class="mono brand">dacunha<span class="tld">.ovh</span></p>
    <p class="muted small">© {year} Julien Da Cunha</p>
    <p class="muted small made">
      {dict.footer.madeWith} <span class="heart" aria-hidden="true">♥</span> &amp;
      <a class="astro" href="https://astro.build" target="_blank" rel="noopener">
        <TechIcon slug="astro" size={14} /> Astro
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
  }

  .brand {
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  .tld {
    color: var(--glacial);
  }

  .small {
    font-size: 0.8125rem;
  }

  .heart {
    color: var(--glacial);
  }

  .made {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .astro {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--bone);
    border-bottom: 1px solid transparent;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .astro:hover {
    color: var(--glacial);
    border-bottom-color: var(--glacial);
  }
</style>
