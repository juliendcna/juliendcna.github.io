---
import TechIcon from './TechIcon.astro';
import ComboToggle from './ComboToggle.astro';
import { t, pathForLocale, locales, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const home = pathForLocale(lang);

const anchors = [
  { href: `${home}#about`, label: dict.nav.about },
  { href: `${home}#experience`, label: dict.nav.experience },
  { href: `${home}#education`, label: dict.nav.education },
  { href: `${home}#skills`, label: dict.nav.skills },
  { href: `${home}#contact`, label: dict.nav.contact },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={pathForLocale(lang)} aria-label="Julien Da Cunha — home">
      <TechIcon slug="jdc" size={30} />
    </a>
    <nav class="anchors" aria-label="Sections">
      {anchors.map((a) => <a href={a.href}>{a.label}</a>)}
      <span class="nav-ink" aria-hidden="true"></span>
    </nav>
    <nav class="langs mono" aria-label={dict.a11y.languageMenu}>
      {
        locales.map((l) => (
          <a href={pathForLocale(l)} class:list={[{ current: l === lang }]} aria-current={l === lang ? 'page' : undefined} lang={l}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <ComboToggle label={dict.a11y.changePalette} />
  </div>
  <span class="scroll-progress" aria-hidden="true"></span>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--night) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline-faint);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    /* white on the dark theme, near-black on the light theme */
    color: var(--bone);
  }

  .anchors {
    position: relative;
    display: none;
    gap: 2rem;
    margin-inline: auto;
  }

  .anchors a.active {
    color: var(--bone);
  }

  /* slides under whichever section is on screen (positioned by the motion script) */
  .nav-ink {
    position: absolute;
    left: 0;
    bottom: -0.45rem;
    width: var(--ink-w, 0);
    height: 2px;
    border-radius: 2px;
    background: var(--glacial);
    opacity: var(--ink-o, 0);
    transform: translateX(var(--ink-x, 0));
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      width 450ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 250ms ease;
  }

  .anchors a {
    font-size: 0.875rem;
    font-weight: 450;
    color: var(--dim);
    transition: color 160ms ease;
  }

  .anchors a:hover {
    color: var(--bone);
  }

  .langs {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .langs a {
    color: var(--dim);
    padding-block: 0.2rem;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease;
  }

  .langs a:hover {
    color: var(--bone);
  }

  .langs a.current {
    color: var(--glacial);
    border-bottom-color: var(--glacial);
  }

  @media (min-width: 880px) {
    .anchors {
      display: flex;
    }

    .langs {
      margin-left: 0;
    }
  }
</style>
