---
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

/* the most important role renders statically; JS crossfades the rest */
const roles = dict.hero.roles;
const staticRole = roles[roles.length - 1];

/* disciplines line derives from the translated skill group names */
const disciplines = dict.skills.groups.map((g) => g.name).join(' / ');

const stack = [
  'Kubernetes',
  'Terraform',
  'Google Cloud',
  'Ansible',
  'Cisco',
  'pfSense',
  'VMware',
  'Linux',
];
const marquee = [...stack, ...stack];
---

<section class="hero">
  <div class="wrap inner">
    <div class="meta mono">
      <p class="loc">{dict.hero.statusLocation}</p>
      <p class="disciplines">{disciplines}</p>
      <p class="pill"><span class="dot" aria-hidden="true"></span>{dict.hero.statusAvailable}</p>
    </div>
    <h1 class="name">
      <span class="line-1">Julien</span>
      <span class="line-2">Da&nbsp;Cunha</span>
    </h1>
    <h2 class="sr-only">{dict.hero.intro} {staticRole}</h2>
    <p class="role" aria-hidden="true">
      <span class="rotator" data-roles={JSON.stringify(roles)}>{staticRole}</span>
    </p>
    <div class="ctas">
      <a class="btn btn--solid" href="mailto:julien@dacunha.ovh">{dict.hero.ctaContact}</a>
      <a class="btn btn--ghost" href="#experience">{dict.hero.ctaResume}</a>
    </div>
  </div>
  <div class="marquee mono" aria-hidden="true">
    <div class="track">
      {marquee.map((item) => <span>{item}<i>·</i></span>)}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 4rem);
    overflow: hidden;
    background:
      radial-gradient(1100px 700px at 82% -10%, var(--glow-a), transparent 62%),
      radial-gradient(900px 600px at -12% 110%, var(--glow-b), transparent 60%);
  }

  .inner {
    width: 100%;
    padding-block: clamp(3rem, 8vh, 6rem) clamp(2.5rem, 6vh, 4rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 2.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    border: 1px solid var(--hairline);
    background: var(--status-wash);
    color: var(--status);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    letter-spacing: 0.12em;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status);
    box-shadow: 0 0 0 0 var(--status-glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s ease-out infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 var(--status-glow);
      }
      70% {
        box-shadow: 0 0 0 9px transparent;
      }
      100% {
        box-shadow: 0 0 0 0 transparent;
      }
    }
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.25rem, 13.5vw, 11rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(1.75rem, 4vh, 2.75rem);
  }

  .line-2 {
    padding-left: clamp(2rem, 9vw, 9rem);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--dim);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .line-2 {
      color: var(--dim);
    }
  }

  .role {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--glacial);
    margin-bottom: clamp(2.25rem, 6vh, 3.5rem);
  }

  .rotator {
    display: inline-block;
    transition: opacity 400ms ease;
  }

  .rotator.fading {
    opacity: 0;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .marquee {
    border-top: 1px solid var(--hairline-faint);
    overflow: hidden;
    padding-block: 1.1rem;
  }

  .track {
    display: flex;
    width: max-content;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .track span {
    display: inline-flex;
    align-items: center;
  }

  .track i {
    font-style: normal;
    color: var(--glacial);
    padding-inline: 1.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: scroll 36s linear infinite;
    }

    @keyframes scroll {
      to {
        transform: translateX(-50%);
      }
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.rotator');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduced) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let index = roles.length - 1;

    window.setInterval(() => {
      el.classList.add('fading');
      window.setTimeout(() => {
        index = (index + 1) % roles.length;
        el.textContent = roles[index]!;
        el.classList.remove('fading');
      }, 420);
    }, 3400);
  }
</script>
