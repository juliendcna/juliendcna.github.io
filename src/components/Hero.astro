---
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

/* the most important role renders statically; JS cycles the rest */
const roles = dict.hero.roles;
const staticRole = roles[roles.length - 1];

const stack = [
  'Kubernetes',
  'Terraform',
  'Google Cloud',
  'Ansible',
  'Cisco',
  'pfSense',
  'VMware',
  'Linux',
];
---

<section class="hero">
  <div class="wrap">
    <p class="status mono">
      <span class="pill"><span class="dot" aria-hidden="true"></span>{dict.hero.statusAvailable}</span>
      <span class="loc muted">{dict.hero.statusLocation}</span>
    </p>
    <h1 class="name" set:html={'Julien<br/>Da&nbsp;Cunha'} />
    <h2 class="sr-only">{dict.hero.intro} {staticRole}</h2>
    <p class="role mono" aria-hidden="true">
      <span class="prompt">&gt;</span>
      <span class="rotator" data-roles={JSON.stringify(roles)}>{staticRole}</span><span class="cursor">▍</span>
    </p>
    <div class="ctas">
      <a class="btn btn--solid" href="mailto:julien@dacunha.ovh">{dict.hero.ctaContact}</a>
      <a class="btn btn--ghost" href="#experience">{dict.hero.ctaResume}</a>
    </div>
  </div>
  <div class="strip mono" aria-hidden="true">
    <div class="wrap strip-inner">
      {stack.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 3.75rem);
    background-image: linear-gradient(var(--rule-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule-faint) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .hero > .wrap {
    padding-block: clamp(3.5rem, 9vh, 7rem) clamp(2.5rem, 6vh, 4rem);
    width: 100%;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    font-size: 0.8125rem;
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--rule);
    background: var(--accent-wash);
    color: var(--accent);
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-bright);
    box-shadow: 0 0 0 0 rgba(31, 199, 126, 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s ease-out infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(31, 199, 126, 0.55);
      }
      70% {
        box-shadow: 0 0 0 9px rgba(31, 199, 126, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(31, 199, 126, 0);
      }
    }
  }

  .name {
    font-size: clamp(3.25rem, 13vw, 9.5rem);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.015em;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .role {
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .prompt {
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .cursor {
    color: var(--accent-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .strip {
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--card) 55%, transparent);
  }

  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
    padding-block: 0.9rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.rotator');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduced) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let index = roles.length - 1;
    let chars = roles[index]!.length;
    let deleting = true;

    const tick = () => {
      const word = roles[index]!;
      chars += deleting ? -1 : 1;
      el.textContent = word.slice(0, chars);

      let delay = deleting ? 40 : 75;
      if (!deleting && chars === word.length) {
        delay = 2600;
        deleting = true;
      } else if (deleting && chars === 0) {
        index = (index + 1) % roles.length;
        deleting = false;
        delay = 350;
      }
      window.setTimeout(tick, delay);
    };

    window.setTimeout(tick, 2600);
  }
</script>
