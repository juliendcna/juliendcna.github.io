---
interface Props {
  id: string;
  keyLabel: string;
  heading: string;
}

const { id, keyLabel, heading } = Astro.props;
---

<section class="section" id={id}>
  <div class="wrap section-grid">
    <p class="key">{keyLabel}</p>
    <div>
      <h2 class="heading" data-reveal>{heading}</h2>
      <slot />
    </div>
  </div>
</section>
