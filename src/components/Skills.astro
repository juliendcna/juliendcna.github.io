---
import SectionShell from './SectionShell.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<SectionShell id="skills" keyLabel={dict.skills.key} heading={dict.skills.heading}>
  <div class="groups">
    {
      dict.skills.groups.map((group) => (
        <div class="group" data-reveal>
          <h3 class="group-name mono">{group.name}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</SectionShell>

<style>
  .groups {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 780px) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .group {
    background: var(--card);
    border: 1px solid var(--rule);
    padding: 1.5rem;
  }

  .group-name {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .group-name::after {
    content: ':';
    color: var(--ink-soft);
  }

  .group ul {
    display: grid;
  }

  .group li {
    font-size: 0.9375rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule-faint);
  }
</style>
