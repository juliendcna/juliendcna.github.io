---
/**
 * Renders a monochrome brand glyph from src/assets/logos/ (Simple Icons SVGs
 * with their brand fill stripped) so it inherits the surrounding text color.
 */
import { spriteUrl } from '../lib/icons';

interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 16 } = Astro.props;
---

<svg width={size} height={size} class="tech-icon" aria-hidden="true"><use href={`${spriteUrl}#${slug}`} /></svg>

<style is:global>
  .tech-icon {
    flex: none;
    fill: currentColor;
    display: block;
  }
</style>
