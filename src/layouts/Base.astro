---
import '../styles/global.css';
import monoLatin400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoLatin500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { combos, comboCss } from '../lib/combos';
import { t, pathForLocale, locales, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  robots?: string;
}

const { lang, robots = 'index, follow' } = Astro.props;
const dict = t(lang);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const site = Astro.site ?? new URL('https://dacunha.ovh');
const canonical = new URL(pathForLocale(lang), site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Julien Da Cunha',
  jobTitle: 'Cloud & DevOps Engineer',
  url: site.href,
  email: 'julien@dacunha.ovh',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Geneva',
    addressCountry: 'CH',
  },
  sameAs: ['https://www.linkedin.com/in/julien-da-cunha', 'https://github.com/juliendcna'],
  knowsAbout: [
    'Kubernetes',
    'Terraform',
    'Google Cloud Platform',
    'DevOps',
    'Network Infrastructure',
    'Linux Administration',
  ],
};

const comboIds = combos.map((c) => c.id);

const ogLocales: Record<Locale, string> = { en: 'en_GB', fr: 'fr_FR', es: 'es_ES' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Julien Da Cunha" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={monoLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin500} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d10" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f1ec" />
    <style is:inline set:html={`${comboCss}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}`}></style>
    <script is:inline define:vars={{ comboIds }}>
      // pick the combo before first paint: today's rotation, unless the visitor chose one today
      (function () {
        var now = new Date();
        var day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 864e5);
        var id = comboIds[day % comboIds.length];
        try {
          var saved = JSON.parse(localStorage.getItem('combo') || 'null');
          if (saved && saved.day === day && comboIds.indexOf(saved.id) !== -1) id = saved.id;
        } catch (e) {}
        document.documentElement.dataset.combo = id;
      })();
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathForLocale(l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={site.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={dict.meta.title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/images/portrait.jpg', site).href} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={dict.meta.title} />
    <meta name="twitter:description" content={dict.meta.description} />
    <meta name="twitter:image" content={new URL('/images/portrait.jpg', site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skipToContent}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/motion';
    </script>
    <script>
      const revealed = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        document.documentElement.classList.add('no-observer');
      }
    </script>
  </body>
</html>
